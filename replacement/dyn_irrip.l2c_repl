
#include "cache.h"

#define MAX_RRPV 3
#define LEADER_INTERVAL 32
#define SAMPLE_INTERVAL 256
#define IRRIP_THRESHOLD 0.25
uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint64_t total_accesses = 0;
uint64_t instruction_accesses = 0;
uint64_t total_misses = 0;
uint64_t instruction_misses = 0;
uint64_t rrip_selections = 0;
uint64_t irrip_selections = 0;
bool use_irrip = false;

bool is_leader_set(uint32_t set)
{
    return (set % LEADER_INTERVAL == 0);
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic I-RRIP for L2C" << endl;

    for (int i = 0; i < L2C_SET; i++) {
        for (int j = 0; j < L2C_WAY; j++)
            l2_rrpv[i][j] = MAX_RRPV;
    }

    total_accesses = 0;
    instruction_accesses = 0;
    total_misses = 0;
    instruction_misses = 0;
    rrip_selections = 0;
    irrip_selections = 0;
    use_irrip = false;
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu,uint64_t instr_id,uint32_t set,const BLOCK *current_set,uint64_t ip,uint64_t full_addr,uint32_t type)
{
    for (int i = 0; i < L2C_WAY; i++) {
        if (!current_set[i].valid)
            return i;
    }
    bool irrip_mode = !is_leader_set(set) && use_irrip;

    while (1) {
        if (irrip_mode) {
            // Prefer replacing data lines in I-RRIP mode.
            bool has_data = false;

            for (int i = 0; i < L2C_WAY; i++) {
                if (!current_set[i].instruction) {
                    has_data = true;
                    break;
                }
            }

            if (has_data) {
                for (int i = 0; i < L2C_WAY; i++) {
                    if (l2_rrpv[set][i] == MAX_RRPV &&
                        !current_set[i].instruction)
                        return i;
                }
            }else {
                for (int i = 0; i < L2C_WAY; i++) {
                    if (l2_rrpv[set][i] == MAX_RRPV)
                        return i;
                }
            }
        }else {
            // Normal RRIP victim selection.
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == MAX_RRPV)
                    return i;
            }
        }

        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] < MAX_RRPV)
                l2_rrpv[set][i]++;
        }
    }
}

void CACHE::l2c_update_replacement_state(uint32_t cpu,uint32_t set,uint32_t way,uint64_t full_addr,uint64_t ip,uint64_t victim_addr,uint32_t type,uint8_t hit,uint8_t isInstruction)
{
    if (way >= L2C_WAY)
        return;

    // Leader sets use RRIP and train the global selector.
    if (is_leader_set(set)) {
        if (type == LOAD || type == RFO) {
            total_accesses++;
            if (isInstruction)
                instruction_accesses++;
            if (!hit) {
                total_misses++;
                if (isInstruction)
                    instruction_misses++;
            }
            if (total_accesses >= SAMPLE_INTERVAL) {
                double ratio = 0.0;
                uint64_t numerator = instruction_accesses + instruction_misses;
                uint64_t denominator = total_accesses + total_misses;

                if (denominator > 0)
                    ratio = (double)numerator / denominator;

                use_irrip = (ratio > IRRIP_THRESHOLD);
                total_accesses = 0;
                instruction_accesses = 0;
                total_misses = 0;
                instruction_misses = 0;
            }
        }

        if (hit) {
            if (type != WRITEBACK)
                l2_rrpv[set][way] = 0;
        }else {
            l2_rrpv[set][way] = MAX_RRPV - 1;
        }

        return;
    }

    if (use_irrip) {
        irrip_selections++;
        if (hit) {
            if (type == WRITEBACK)
                return;
            if (isInstruction)
                l2_rrpv[set][way] = 0;
            else
                l2_rrpv[set][way] = 1;
        }
        else {
            if (isInstruction)
                l2_rrpv[set][way] = 1;
            else
                l2_rrpv[set][way] = 2;
        }
    }else {
        rrip_selections++;

        if (hit) {
            if (type != WRITEBACK)
                l2_rrpv[set][way] = 0;
        }else {
            l2_rrpv[set][way] = MAX_RRPV - 1;
        }
    }
}

void CACHE::l2c_replacement_final_stats()
{
    cout << "Dynamic I-RRIP final stats" << endl;
    cout << "RRIP follower updates: "<< rrip_selections << endl;
    cout << "I-RRIP follower updates: "<< irrip_selections << endl;
    cout << "Final follower mode: "<< (use_irrip ? "I-RRIP" : "RRIP") << endl;
    cout << "Threshold: " << IRRIP_THRESHOLD << endl;
}
