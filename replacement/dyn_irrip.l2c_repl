#include "cache.h"

#ifndef DYN_IRRIP_MAX_RRPV
#define DYN_IRRIP_MAX_RRPV 3
#endif
#ifndef DYN_IRRIP_DATA_INSERT_RRPV
#define DYN_IRRIP_DATA_INSERT_RRPV (DYN_IRRIP_MAX_RRPV - 1)
#endif
#ifndef DYN_IRRIP_INSTR_INSERT_RRPV
#define DYN_IRRIP_INSTR_INSERT_RRPV 0
#endif
#ifndef DYN_IRRIP_DATA_HIT_RRPV
#define DYN_IRRIP_DATA_HIT_RRPV 1
#endif
#ifndef DYN_IRRIP_INSTR_HIT_RRPV
#define DYN_IRRIP_INSTR_HIT_RRPV 0
#endif

// One set in each 64-set region is an RRIP leader and one is an I-RRIP leader.
// Followers use I-RRIP only when leader sets show enough instruction pressure
// and the I-RRIP leaders are not losing to the RRIP leaders on total miss rate.
#ifndef DYN_IRRIP_LEADER_PERIOD
#define DYN_IRRIP_LEADER_PERIOD 64
#endif
#ifndef DYN_IRRIP_RRIP_LEADER_OFFSET
#define DYN_IRRIP_RRIP_LEADER_OFFSET 0
#endif
#ifndef DYN_IRRIP_IRRIP_LEADER_OFFSET
#define DYN_IRRIP_IRRIP_LEADER_OFFSET 1
#endif
#ifndef DYN_IRRIP_THRESHOLD_NUMERATOR
#define DYN_IRRIP_THRESHOLD_NUMERATOR 1
#endif
#ifndef DYN_IRRIP_THRESHOLD_DENOMINATOR
#define DYN_IRRIP_THRESHOLD_DENOMINATOR 4
#endif
#ifndef DYN_IRRIP_MAX_COUNTER
#define DYN_IRRIP_MAX_COUNTER 1048576
#endif
#ifndef DYN_IRRIP_REQUIRE_MISS_RATE_WIN
#define DYN_IRRIP_REQUIRE_MISS_RATE_WIN 1
#endif
#define DYN_IRRIP_POLICY_RRIP 0
#define DYN_IRRIP_POLICY_IRRIP 1
#define DYN_IRRIP_CLASS_INSTR 0
#define DYN_IRRIP_CLASS_NON_INSTR 1

uint32_t l2_dyn_irrip_rrpv[L2C_SET][L2C_WAY];
uint64_t dyn_leader_access[2][2];
uint64_t dyn_leader_miss[2][2];
uint64_t dyn_follow_rrip_sets = 0;
uint64_t dyn_follow_irrip_sets = 0;

static bool dyn_is_rrip_leader(uint32_t set)
{
    return (set % DYN_IRRIP_LEADER_PERIOD) == DYN_IRRIP_RRIP_LEADER_OFFSET;
}

static bool dyn_is_irrip_leader(uint32_t set)
{
    return (set % DYN_IRRIP_LEADER_PERIOD) == DYN_IRRIP_IRRIP_LEADER_OFFSET;
}

static uint64_t dyn_policy_access(uint32_t policy)
{
    return dyn_leader_access[policy][DYN_IRRIP_CLASS_INSTR] +
           dyn_leader_access[policy][DYN_IRRIP_CLASS_NON_INSTR];
}

static uint64_t dyn_policy_miss(uint32_t policy)
{
    return dyn_leader_miss[policy][DYN_IRRIP_CLASS_INSTR] +
           dyn_leader_miss[policy][DYN_IRRIP_CLASS_NON_INSTR];
}

static bool dyn_instruction_pressure_above_threshold()
{
    // Assignment threshold: instruction-line accesses / all leader-set accesses.
    // Misses are tracked separately below and are not added again to accesses.
    uint64_t instr_events = dyn_leader_access[DYN_IRRIP_POLICY_RRIP][DYN_IRRIP_CLASS_INSTR] +
                            dyn_leader_access[DYN_IRRIP_POLICY_IRRIP][DYN_IRRIP_CLASS_INSTR];
    uint64_t total_events = dyn_policy_access(DYN_IRRIP_POLICY_RRIP) +
                            dyn_policy_access(DYN_IRRIP_POLICY_IRRIP);

    if (total_events == 0)
        return false;

    return (instr_events * DYN_IRRIP_THRESHOLD_DENOMINATOR) >
           (total_events * DYN_IRRIP_THRESHOLD_NUMERATOR);
}

static bool dyn_irrip_leaders_match_or_beat_rrip()
{
    uint64_t rrip_access = dyn_policy_access(DYN_IRRIP_POLICY_RRIP);
    uint64_t irrip_access = dyn_policy_access(DYN_IRRIP_POLICY_IRRIP);

    if ((rrip_access == 0) || (irrip_access == 0))
        return false;

    uint64_t rrip_miss = dyn_policy_miss(DYN_IRRIP_POLICY_RRIP);
    uint64_t irrip_miss = dyn_policy_miss(DYN_IRRIP_POLICY_IRRIP);

    return (irrip_miss * rrip_access) <= (rrip_miss * irrip_access);
}

static bool dyn_followers_use_irrip()
{
    if (!dyn_instruction_pressure_above_threshold())
        return false;

#if DYN_IRRIP_REQUIRE_MISS_RATE_WIN
    return dyn_irrip_leaders_match_or_beat_rrip();
#else
    return true;
#endif
}

static bool dyn_use_irrip(uint32_t set)
{
    if (dyn_is_rrip_leader(set))
        return false;
    if (dyn_is_irrip_leader(set))
        return true;
    return dyn_followers_use_irrip();
}

static void dyn_age_rrip(uint32_t set)
{
    for (int i=0; i<L2C_WAY; i++)
        if (l2_dyn_irrip_rrpv[set][i] < DYN_IRRIP_MAX_RRPV)
            l2_dyn_irrip_rrpv[set][i]++;
}

static uint32_t dyn_rrip_victim(uint32_t set, const BLOCK *current_set)
{
    for (int i=0; i<L2C_WAY; i++)
        if (current_set[i].valid == false)
            return i;

    while (1) {
        for (int i=0; i<L2C_WAY; i++)
            if (l2_dyn_irrip_rrpv[set][i] == DYN_IRRIP_MAX_RRPV)
                return i;

        dyn_age_rrip(set);
    }
}

static uint32_t dyn_irrip_victim(uint32_t set, const BLOCK *current_set)
{
    for (int i=0; i<L2C_WAY; i++)
        if (current_set[i].valid == false)
            return i;

    while (1) {
        for (int i=0; i<L2C_WAY; i++)
            if ((current_set[i].instruction == 0) && (l2_dyn_irrip_rrpv[set][i] == DYN_IRRIP_MAX_RRPV))
                return i;

        bool aged_non_instruction = false;
        for (int i=0; i<L2C_WAY; i++) {
            if ((current_set[i].instruction == 0) && (l2_dyn_irrip_rrpv[set][i] < DYN_IRRIP_MAX_RRPV)) {
                l2_dyn_irrip_rrpv[set][i]++;
                aged_non_instruction = true;
            }
        }

        if (aged_non_instruction)
            continue;

        for (int i=0; i<L2C_WAY; i++)
            if (l2_dyn_irrip_rrpv[set][i] == DYN_IRRIP_MAX_RRPV)
                return i;

        dyn_age_rrip(set);
    }
}

static void dyn_update_rrip(uint32_t set, uint32_t way, uint8_t hit)
{
    l2_dyn_irrip_rrpv[set][way] = hit ? 0 : DYN_IRRIP_DATA_INSERT_RRPV;
}

static void dyn_update_irrip(uint32_t set, uint32_t way, uint8_t hit, uint8_t isInstruction)
{
    if (hit)
        l2_dyn_irrip_rrpv[set][way] = isInstruction ? DYN_IRRIP_INSTR_HIT_RRPV : DYN_IRRIP_DATA_HIT_RRPV;
    else
        l2_dyn_irrip_rrpv[set][way] = isInstruction ? DYN_IRRIP_INSTR_INSERT_RRPV : DYN_IRRIP_DATA_INSERT_RRPV;
}

static void dyn_decay_leader_stats()
{
    uint64_t total_access = dyn_policy_access(DYN_IRRIP_POLICY_RRIP) +
                            dyn_policy_access(DYN_IRRIP_POLICY_IRRIP);
    if (total_access <= DYN_IRRIP_MAX_COUNTER)
        return;

    for (int policy=0; policy<2; policy++) {
        for (int access_class=0; access_class<2; access_class++) {
            dyn_leader_access[policy][access_class] >>= 1;
            dyn_leader_miss[policy][access_class] >>= 1;
        }
    }
}

static void dyn_update_leader_stats(uint32_t policy, uint8_t hit, uint8_t isInstruction)
{
    uint32_t access_class = isInstruction ? DYN_IRRIP_CLASS_INSTR : DYN_IRRIP_CLASS_NON_INSTR;

    dyn_leader_access[policy][access_class]++;
    if (!hit)
        dyn_leader_miss[policy][access_class]++;

    dyn_decay_leader_stats();
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic I-RRIP state for L2C" << endl;
    cout << "Dynamic I-RRIP threshold: "
         << DYN_IRRIP_THRESHOLD_NUMERATOR << "/"
         << DYN_IRRIP_THRESHOLD_DENOMINATOR << endl;
    cout << "Dynamic I-RRIP requires I-RRIP leader miss-rate win: "
         << DYN_IRRIP_REQUIRE_MISS_RATE_WIN << endl;

    for (int policy=0; policy<2; policy++) {
        for (int access_class=0; access_class<2; access_class++) {
            dyn_leader_access[policy][access_class] = 0;
            dyn_leader_miss[policy][access_class] = 0;
        }
    }
    dyn_follow_rrip_sets = 0;
    dyn_follow_irrip_sets = 0;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_dyn_irrip_rrpv[i][j] = DYN_IRRIP_MAX_RRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    if (dyn_use_irrip(set))
        return dyn_irrip_victim(set, current_set);

    return dyn_rrip_victim(set, current_set);
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    if (dyn_is_rrip_leader(set)) {
        dyn_update_leader_stats(DYN_IRRIP_POLICY_RRIP, hit, isInstruction);
        dyn_update_rrip(set, way, hit);
        return;
    }

    if (dyn_is_irrip_leader(set)) {
        dyn_update_leader_stats(DYN_IRRIP_POLICY_IRRIP, hit, isInstruction);
        dyn_update_irrip(set, way, hit, isInstruction);
        return;
    }

    if (dyn_followers_use_irrip()) {
        dyn_follow_irrip_sets++;
        dyn_update_irrip(set, way, hit, isInstruction);
    }
    else {
        dyn_follow_rrip_sets++;
        dyn_update_rrip(set, way, hit);
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "Dynamic I-RRIP RRIP leaders instr access: "
         << dyn_leader_access[DYN_IRRIP_POLICY_RRIP][DYN_IRRIP_CLASS_INSTR]
         << " non-instr access: "
         << dyn_leader_access[DYN_IRRIP_POLICY_RRIP][DYN_IRRIP_CLASS_NON_INSTR]
         << " instr miss: "
         << dyn_leader_miss[DYN_IRRIP_POLICY_RRIP][DYN_IRRIP_CLASS_INSTR]
         << " non-instr miss: "
         << dyn_leader_miss[DYN_IRRIP_POLICY_RRIP][DYN_IRRIP_CLASS_NON_INSTR] << endl;
    cout << "Dynamic I-RRIP I-RRIP leaders instr access: "
         << dyn_leader_access[DYN_IRRIP_POLICY_IRRIP][DYN_IRRIP_CLASS_INSTR]
         << " non-instr access: "
         << dyn_leader_access[DYN_IRRIP_POLICY_IRRIP][DYN_IRRIP_CLASS_NON_INSTR]
         << " instr miss: "
         << dyn_leader_miss[DYN_IRRIP_POLICY_IRRIP][DYN_IRRIP_CLASS_INSTR]
         << " non-instr miss: "
         << dyn_leader_miss[DYN_IRRIP_POLICY_IRRIP][DYN_IRRIP_CLASS_NON_INSTR] << endl;
    cout << "Dynamic I-RRIP follower updates in RRIP mode: " << dyn_follow_rrip_sets
         << " I-RRIP mode: " << dyn_follow_irrip_sets << endl;
}
