#include "cache.h"

#define maxRRPV 3
#define PREFETCH_INSERT 1
#define LEADER_INTERVAL 64
#define SAMPLE_WINDOW 4096
#define IRRIP_THRESHOLD 0.25
#define HYSTERESIS 0.02

uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint32_t instruction_accesses = 0, data_accesses = 0;
uint32_t instruction_misses = 0, data_misses = 0;
bool instruction_priority = false;
uint64_t sample_windows = 0, instruction_windows = 0, mode_changes = 0;

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic IRRIP state for L2C" << endl;
    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }

    instruction_accesses = data_accesses = 0;
    instruction_misses = data_misses = 0;
    instruction_priority = false;
    sample_windows = instruction_windows = mode_changes = 0;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // Leader sets always use RRIP; the other sets follow the current mode.
    bool use_irrip = instruction_priority && (set % LEADER_INTERVAL != 0);
    for (int i=0; i<L2C_WAY; i++)
        if (!current_set[i].valid){
            return i;
        }

    while (1)
    {
        // In IRRIP mode, choose data first among equally old lines.
        if (use_irrip) {
            for (int i=0; i<L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction){
                    return i;
                }
        }

        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV){
                return i;
            }

        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    bool leader = (set % LEADER_INTERVAL == 0);
    // I keep SPP data prefetches separate from demand updates.
    if (!leader && type == PREFETCH && !isInstruction) {
        if (!hit){
            l2_rrpv[set][way] = PREFETCH_INSERT;
        }
        return;
    }

    // Only demand loads and RFOs in leader sets train the decision.
    if (leader && (type == LOAD || type == RFO)) {
        if (isInstruction) {
            instruction_accesses++;
            if (!hit){
                instruction_misses++;
            }
        }else {
            data_accesses++;
            if (!hit){
                data_misses++;
            }
        }

        uint32_t total_accesses = instruction_accesses + data_accesses;
        uint32_t total_misses = instruction_misses + data_misses;
        if (total_accesses >= SAMPLE_WINDOW) {
            double score = double(instruction_accesses + instruction_misses) / (total_accesses + total_misses);

            bool old_mode = instruction_priority;
            // Keep the current mode when the score is near the threshold.
            if (score > IRRIP_THRESHOLD + HYSTERESIS){
                instruction_priority = true;
            }else if (score < IRRIP_THRESHOLD - HYSTERESIS){
                instruction_priority = false;
            }

            sample_windows++;
            if (instruction_priority){
                instruction_windows++;
            }
            if (instruction_priority != old_mode){
                mode_changes++;
            }
            instruction_accesses = data_accesses = 0;
            instruction_misses = data_misses = 0;
        }
    }

    bool use_irrip = instruction_priority && !leader;
    if (!use_irrip) {
        l2_rrpv[set][way] = hit ? 0 : maxRRPV-1;
    }else if (hit) {
        if (isInstruction || l2_rrpv[set][way] > 1)
            l2_rrpv[set][way] = isInstruction ? 0 : 1;
    }else {
        l2_rrpv[set][way] = isInstruction ? 1 : maxRRPV-1;
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "Dynamic IRRIP whole-run windows: " << sample_windows << " instruction windows: " << instruction_windows<< " mode changes: " << mode_changes << endl;
    cout << "SPP-aware prefetch insertion RRPV: " << PREFETCH_INSERT << endl;
    cout << "Dynamic IRRIP threshold: " << IRRIP_THRESHOLD<< " leader interval: " << LEADER_INTERVAL << " sample window: " << SAMPLE_WINDOW << endl;
}
