#include "cache.h"

#ifndef DYN_BALANCED_MAX_RRPV
#define DYN_BALANCED_MAX_RRPV 3
#endif
#ifndef DYN_BALANCED_DATA_INSERT_RRPV
#define DYN_BALANCED_DATA_INSERT_RRPV (DYN_BALANCED_MAX_RRPV - 1)
#endif
#ifndef DYN_BALANCED_INSTR_INSERT_RRPV
#define DYN_BALANCED_INSTR_INSERT_RRPV 1
#endif
#ifndef DYN_BALANCED_HIT_RRPV
#define DYN_BALANCED_HIT_RRPV 0
#endif

// One set in each 64-set region is an RRIP leader and one is a balanced
// I-RRIP leader. Followers use balanced I-RRIP only when instruction pressure
// is high and the online selector favors the instruction-conscious leaders.
#ifndef DYN_BALANCED_LEADER_PERIOD
#define DYN_BALANCED_LEADER_PERIOD 64
#endif
#ifndef DYN_BALANCED_RRIP_LEADER_OFFSET
#define DYN_BALANCED_RRIP_LEADER_OFFSET 0
#endif
#ifndef DYN_BALANCED_IRRIP_LEADER_OFFSET
#define DYN_BALANCED_IRRIP_LEADER_OFFSET 1
#endif
#ifndef DYN_BALANCED_THRESHOLD_NUMERATOR
#define DYN_BALANCED_THRESHOLD_NUMERATOR 1
#endif
#ifndef DYN_BALANCED_THRESHOLD_DENOMINATOR
#define DYN_BALANCED_THRESHOLD_DENOMINATOR 4
#endif
#ifndef DYN_BALANCED_MAX_COUNTER
#define DYN_BALANCED_MAX_COUNTER 1048576
#endif

#define DYN_BALANCED_POLICY_RRIP 0
#define DYN_BALANCED_POLICY_IRRIP 1
#define DYN_BALANCED_CLASS_INSTR 0
#define DYN_BALANCED_CLASS_NON_INSTR 1
#define DYN_BALANCED_PSEL_MAX 1023
#define DYN_BALANCED_PSEL_INIT (DYN_BALANCED_PSEL_MAX / 2)

uint32_t l2_dyn_balanced_rrpv[L2C_SET][L2C_WAY];
uint64_t dyn_balanced_leader_access[2][2];
uint64_t dyn_balanced_leader_miss[2][2];
uint64_t dyn_balanced_follow_rrip_updates = 0;
uint64_t dyn_balanced_follow_irrip_updates = 0;
int32_t dyn_balanced_psel = DYN_BALANCED_PSEL_INIT;

static bool dyn_balanced_is_rrip_leader(uint32_t set)
{
    return (set % DYN_BALANCED_LEADER_PERIOD) == DYN_BALANCED_RRIP_LEADER_OFFSET;
}

static bool dyn_balanced_is_irrip_leader(uint32_t set)
{
    return (set % DYN_BALANCED_LEADER_PERIOD) == DYN_BALANCED_IRRIP_LEADER_OFFSET;
}

static uint64_t dyn_balanced_policy_access(uint32_t policy)
{
    return dyn_balanced_leader_access[policy][DYN_BALANCED_CLASS_INSTR] +
           dyn_balanced_leader_access[policy][DYN_BALANCED_CLASS_NON_INSTR];
}

static uint64_t dyn_balanced_policy_miss(uint32_t policy)
{
    return dyn_balanced_leader_miss[policy][DYN_BALANCED_CLASS_INSTR] +
           dyn_balanced_leader_miss[policy][DYN_BALANCED_CLASS_NON_INSTR];
}

static uint64_t dyn_balanced_pressure_numerator()
{
    return dyn_balanced_leader_access[DYN_BALANCED_POLICY_RRIP][DYN_BALANCED_CLASS_INSTR] +
           dyn_balanced_leader_access[DYN_BALANCED_POLICY_IRRIP][DYN_BALANCED_CLASS_INSTR] +
           dyn_balanced_leader_miss[DYN_BALANCED_POLICY_RRIP][DYN_BALANCED_CLASS_INSTR] +
           dyn_balanced_leader_miss[DYN_BALANCED_POLICY_IRRIP][DYN_BALANCED_CLASS_INSTR];
}

static uint64_t dyn_balanced_pressure_denominator()
{
    return dyn_balanced_policy_access(DYN_BALANCED_POLICY_RRIP) +
           dyn_balanced_policy_access(DYN_BALANCED_POLICY_IRRIP) +
           dyn_balanced_policy_miss(DYN_BALANCED_POLICY_RRIP) +
           dyn_balanced_policy_miss(DYN_BALANCED_POLICY_IRRIP);
}

static bool dyn_balanced_instruction_pressure_above_threshold()
{
    uint64_t numerator = dyn_balanced_pressure_numerator();
    uint64_t denominator = dyn_balanced_pressure_denominator();

    if (denominator == 0)
        return false;

    return (numerator * DYN_BALANCED_THRESHOLD_DENOMINATOR) >
           (denominator * DYN_BALANCED_THRESHOLD_NUMERATOR);
}

static bool dyn_balanced_selector_favors_irrip()
{
    return dyn_balanced_psel > DYN_BALANCED_PSEL_INIT;
}

static bool dyn_balanced_followers_use_irrip()
{
    return dyn_balanced_instruction_pressure_above_threshold() &&
           dyn_balanced_selector_favors_irrip();
}

static bool dyn_balanced_use_irrip(uint32_t set)
{
    if (dyn_balanced_is_rrip_leader(set))
        return false;
    if (dyn_balanced_is_irrip_leader(set))
        return true;
    return dyn_balanced_followers_use_irrip();
}

static void dyn_balanced_age(uint32_t set)
{
    for (int i=0; i<L2C_WAY; i++)
        if (l2_dyn_balanced_rrpv[set][i] < DYN_BALANCED_MAX_RRPV)
            l2_dyn_balanced_rrpv[set][i]++;
}

static uint32_t dyn_balanced_rrip_victim(uint32_t set, const BLOCK *current_set)
{
    for (int i=0; i<L2C_WAY; i++)
        if (current_set[i].valid == false)
            return i;

    while (1) {
        for (int i=0; i<L2C_WAY; i++)
            if (l2_dyn_balanced_rrpv[set][i] == DYN_BALANCED_MAX_RRPV)
                return i;

        dyn_balanced_age(set);
    }
}

static uint32_t dyn_balanced_irrip_victim(uint32_t set, const BLOCK *current_set)
{
    for (int i=0; i<L2C_WAY; i++)
        if (current_set[i].valid == false)
            return i;

    while (1) {
        for (int i=0; i<L2C_WAY; i++)
            if ((current_set[i].instruction == 0) &&
                (l2_dyn_balanced_rrpv[set][i] == DYN_BALANCED_MAX_RRPV))
                return i;

        for (int i=0; i<L2C_WAY; i++)
            if (l2_dyn_balanced_rrpv[set][i] == DYN_BALANCED_MAX_RRPV)
                return i;

        dyn_balanced_age(set);
    }
}

static void dyn_balanced_update_rrip(uint32_t set, uint32_t way, uint8_t hit)
{
    l2_dyn_balanced_rrpv[set][way] = hit ? DYN_BALANCED_HIT_RRPV :
                                           DYN_BALANCED_DATA_INSERT_RRPV;
}

static void dyn_balanced_update_irrip(uint32_t set, uint32_t way, uint8_t hit, uint8_t isInstruction)
{
    if (hit)
        l2_dyn_balanced_rrpv[set][way] = DYN_BALANCED_HIT_RRPV;
    else
        l2_dyn_balanced_rrpv[set][way] = isInstruction ?
                                         DYN_BALANCED_INSTR_INSERT_RRPV :
                                         DYN_BALANCED_DATA_INSERT_RRPV;
}

static void dyn_balanced_decay_leader_stats()
{
    uint64_t total_access = dyn_balanced_policy_access(DYN_BALANCED_POLICY_RRIP) +
                            dyn_balanced_policy_access(DYN_BALANCED_POLICY_IRRIP);
    if (total_access <= DYN_BALANCED_MAX_COUNTER)
        return;

    for (int policy=0; policy<2; policy++) {
        for (int access_class=0; access_class<2; access_class++) {
            dyn_balanced_leader_access[policy][access_class] >>= 1;
            dyn_balanced_leader_miss[policy][access_class] >>= 1;
        }
    }

    dyn_balanced_psel = DYN_BALANCED_PSEL_INIT +
                        ((dyn_balanced_psel - DYN_BALANCED_PSEL_INIT) / 2);
}

static void dyn_balanced_update_leader_stats(uint32_t policy, uint8_t hit, uint8_t isInstruction)
{
    uint32_t access_class = isInstruction ? DYN_BALANCED_CLASS_INSTR :
                                            DYN_BALANCED_CLASS_NON_INSTR;

    dyn_balanced_leader_access[policy][access_class]++;
    if (!hit) {
        dyn_balanced_leader_miss[policy][access_class]++;

        if ((policy == DYN_BALANCED_POLICY_RRIP) &&
            (dyn_balanced_psel < DYN_BALANCED_PSEL_MAX))
            dyn_balanced_psel++;
        else if ((policy == DYN_BALANCED_POLICY_IRRIP) &&
                 (dyn_balanced_psel > 0))
            dyn_balanced_psel--;
    }

    dyn_balanced_decay_leader_stats();
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize balanced Dynamic I-RRIP state for L2C" << endl;
    cout << "Balanced Dynamic I-RRIP threshold: "
         << DYN_BALANCED_THRESHOLD_NUMERATOR << "/"
         << DYN_BALANCED_THRESHOLD_DENOMINATOR << endl;

    for (int policy=0; policy<2; policy++) {
        for (int access_class=0; access_class<2; access_class++) {
            dyn_balanced_leader_access[policy][access_class] = 0;
            dyn_balanced_leader_miss[policy][access_class] = 0;
        }
    }
    dyn_balanced_follow_rrip_updates = 0;
    dyn_balanced_follow_irrip_updates = 0;
    dyn_balanced_psel = DYN_BALANCED_PSEL_INIT;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_dyn_balanced_rrpv[i][j] = DYN_BALANCED_MAX_RRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    if (dyn_balanced_use_irrip(set))
        return dyn_balanced_irrip_victim(set, current_set);

    return dyn_balanced_rrip_victim(set, current_set);
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    if (dyn_balanced_is_rrip_leader(set)) {
        dyn_balanced_update_leader_stats(DYN_BALANCED_POLICY_RRIP, hit, isInstruction);
        dyn_balanced_update_rrip(set, way, hit);
        return;
    }

    if (dyn_balanced_is_irrip_leader(set)) {
        dyn_balanced_update_leader_stats(DYN_BALANCED_POLICY_IRRIP, hit, isInstruction);
        dyn_balanced_update_irrip(set, way, hit, isInstruction);
        return;
    }

    if (dyn_balanced_followers_use_irrip()) {
        dyn_balanced_follow_irrip_updates++;
        dyn_balanced_update_irrip(set, way, hit, isInstruction);
    }
    else {
        dyn_balanced_follow_rrip_updates++;
        dyn_balanced_update_rrip(set, way, hit);
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "Balanced Dynamic I-RRIP RRIP leaders instr access: "
         << dyn_balanced_leader_access[DYN_BALANCED_POLICY_RRIP][DYN_BALANCED_CLASS_INSTR]
         << " non-instr access: "
         << dyn_balanced_leader_access[DYN_BALANCED_POLICY_RRIP][DYN_BALANCED_CLASS_NON_INSTR]
         << " instr miss: "
         << dyn_balanced_leader_miss[DYN_BALANCED_POLICY_RRIP][DYN_BALANCED_CLASS_INSTR]
         << " non-instr miss: "
         << dyn_balanced_leader_miss[DYN_BALANCED_POLICY_RRIP][DYN_BALANCED_CLASS_NON_INSTR] << endl;
    cout << "Balanced Dynamic I-RRIP I-RRIP leaders instr access: "
         << dyn_balanced_leader_access[DYN_BALANCED_POLICY_IRRIP][DYN_BALANCED_CLASS_INSTR]
         << " non-instr access: "
         << dyn_balanced_leader_access[DYN_BALANCED_POLICY_IRRIP][DYN_BALANCED_CLASS_NON_INSTR]
         << " instr miss: "
         << dyn_balanced_leader_miss[DYN_BALANCED_POLICY_IRRIP][DYN_BALANCED_CLASS_INSTR]
         << " non-instr miss: "
         << dyn_balanced_leader_miss[DYN_BALANCED_POLICY_IRRIP][DYN_BALANCED_CLASS_NON_INSTR] << endl;
    cout << "Balanced Dynamic I-RRIP follower updates in RRIP mode: "
         << dyn_balanced_follow_rrip_updates
         << " I-RRIP mode: " << dyn_balanced_follow_irrip_updates << endl;
    cout << "Balanced Dynamic I-RRIP selector: " << dyn_balanced_psel
         << " neutral: " << DYN_BALANCED_PSEL_INIT
         << " pressure numerator: " << dyn_balanced_pressure_numerator()
         << " denominator: " << dyn_balanced_pressure_denominator() << endl;
}
